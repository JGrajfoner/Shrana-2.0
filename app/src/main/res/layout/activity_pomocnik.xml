<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ozadje"
    android:fitsSystemWindows="true">

    <TextView
        style="@style/NaslovZaslona"
        android:text="Pomočnik" />

    <!-- Pogovor s pomočnikom -->
    <ScrollView
        android:id="@+id/drsnikPogovora"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/vsebnikPogovora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipToPadding="false" />

    </ScrollView>

    <!-- Vnosna vrstica - poenoteno s Seznamom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:background="@color/ozadje">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vnosLayout"
            style="@style/Polje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/mic_24px"
            app:startIconContentDescription="Govorni vnos">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vnosSporocila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Vprašaj pomočnika ..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/gumbPoslji"
            style="@style/Gumb.Tonalni"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pošlji"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/spodnjaNavigacija"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/povrsina"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>