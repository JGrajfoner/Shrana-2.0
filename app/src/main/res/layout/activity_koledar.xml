<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ozadje"
    android:fitsSystemWindows="true">

    <TextView
        style="@style/NaslovZaslona"
        android:text="@string/naslov_koledar" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Kartica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/gumbPrejsnjiMesec"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/arrow_back_24px"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/opis_prejsnji_mesec" />

                <TextView
                    android:id="@+id/mesecLeto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="Mesec"
                    android:textColor="@color/besedilo_primarno"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <ImageButton
                    android:id="@+id/gumbNaslednjiMesec"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/arrow_back_24px"
                    android:rotation="180"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/opis_naslednji_mesec" />

            </LinearLayout>

            <GridLayout
                android:id="@+id/koledarMreza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/izbraniDatum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/koledar_izberi_dan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/besedilo_primarno"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Sem iz kode vstavimo tri vrstice: Zajtrk, Kosilo, Večerja -->
        <LinearLayout
            android:id="@+id/vsebinaObrokov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/spodnjaNavigacija"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/povrsina"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>